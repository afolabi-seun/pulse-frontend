VITE_API_BASE_URL=http://localhost:5284

# Demo banner — only set these in a throwaway demo build. Credentials supplied
# here are inlined into the bundle, so NEVER point them at real accounts.
VITE_SHOW_DEMO_BANNER=false
# VITE_DEMO_PASSWORD=Demo@12345!
# VITE_DEMO_PERSONAS=[{"email":"alice@pulse.demo","role":"Head of R&D"},{"email":"bob@pulse.demo","role":"Project Manager"}]

# Build-time only (not a VITE_ var): set BUILD_SOURCEMAP=true in CI to emit
# "hidden" sourcemaps for an error tracker. Leave unset for production so no
# readable source ships in dist/.
